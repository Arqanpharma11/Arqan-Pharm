rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'qpuH4fWGhSYFq0mqTGfIEIn4VS13';
    }

    // Orders are currently public because the existing pharmacist portal
    // reads the shared collection without Firebase Authentication.
    // Keep create enabled for order submission; only admin may modify/delete.
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Existing pharmacist sign-in is still client-side and unauthenticated.
    // These permissions preserve it but do NOT protect pharmacist records.
    match /pharmacists/{phone} {
      allow read, write: if true;
    }

    // Public storefront reads catalog/margins; only admin may change settings.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Archive remains readable by the current portal; only admin may write.
    match /ordersArchive/{orderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Images are read by storefront users and changed from the admin catalog.
    match /productImages/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pharmacists may submit cancellation requests; only the authenticated admin can review them.
    match /orderCancellationRequests/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Default deny for every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}