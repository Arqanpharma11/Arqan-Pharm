rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'qpuH4fWGhSYFq0mqTGfIEIn4VS13';
    }

    // Orders remain readable and creatable by the current pharmacist flow.
    // Only the authenticated admin can change or delete existing orders.
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Pharmacist registration and the current client-side pharmacist flow
    // still depend on unauthenticated access. This is NOT private yet.
    match /pharmacists/{phone} {
      allow read, write: if true;
    }

    // Public catalog/margins reads are needed by the storefront.
    // Only the authenticated admin can publish changes.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The existing app reads the archive in the storefront session.
    // Archive writes/deletes are admin-only.
    match /ordersArchive/{orderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Existing image helper can write these from the client, so this
    // collection remains public until that feature is moved behind admin auth.
    match /productImages/{productId} {
      allow read, write: if true;
    }

    // Deny everything not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}